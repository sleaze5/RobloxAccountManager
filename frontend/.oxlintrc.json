{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"perf": "warn",
		"suspicious": "error"
	},
	"plugins": ["eslint", "typescript", "oxc", "import", "promise"],
	"env": {
		"browser": true,
		"builtin": true
	},
	"ignorePatterns": [
		"bindings/**",
		"dist/**",
		"node_modules/**",
		"frontend/**",
		".bindings-tmp-*/**",
		".svelte-check/**"
	],
	"options": {
		"typeAware": true,
		"typeCheck": false
	},
	"rules": {
		"complexity": ["error", 15],
		"import/no-unassigned-import": "off",
		"typescript/no-unsafe-type-assertion": "off",
		"no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"regex": "^phosphor-svelte(/|$)",
						"message": "Import icons as @phosphor-icons/core/<weight>/<name>.svg?raw and render them with lib/shared/Icon.svelte."
					},
					{
						"regex": "^@phosphor-icons/core($|/(assets|dist)/|/[^?]*$|/.*\\?([^r]|r[^a]|ra[^w]|raw.))",
						"message": "Import each icon as @phosphor-icons/core/<weight>/<name>.svg?raw so that only the used weight is bundled."
					},
					{
						"regex": "(^|/)bindings/",
						"message": "Import generated bindings through src/lib/backend/bridge.ts."
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["vite.config.ts", "svelte.config.js", "scripts/**"],
			"env": {
				"browser": false,
				"node": true
			}
		},
		{
			"files": ["src/lib/backend/bridge.ts"],
			"rules": {
				"no-restricted-imports": "off"
			}
		}
	]
}
