{
	"name": "RobloxAccountManager",
	"private": true,
	"description": "A portable desktop application for storing and managing Roblox accounts.",
	"author": {
		"name": "sleaze5",
		"displayName": "sleaze",
		"url": "https://github.com/sleaze5"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sleaze5/RobloxAccountManager.git"
	},
	"homepage": "https://github.com/sleaze5/RobloxAccountManager#readme",
	"bugs": {
		"url": "https://github.com/sleaze5/RobloxAccountManager/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build:dev": "vite build --minify false --mode development",
		"build": "vite build --mode production",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo && tsc -p ../scripts",
		"lint": "oxlint --deny-warnings . && cd .. && oxlint -c frontend/.oxlintrc.json --deny-warnings scripts",
		"lint:fix": "oxlint --fix --deny-warnings . && cd .. && oxlint -c frontend/.oxlintrc.json --fix --deny-warnings scripts",
		"format": "bun fmt && bun fmt --config .oxfmtrc.json ../scripts",
		"format:check": "bun fmt --check && bun fmt --config .oxfmtrc.json --check ../scripts"
	},
	"dependencies": {
		"@wailsio/runtime": "3.0.0-beta.34",
		"phosphor-svelte": "3.1.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tsconfig/svelte": "5.0.8",
		"@types/bun": "1.4.4",
		"@typescript/native": "npm:typescript@7.0.2",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4",
			"onFail": "download"
		}
	}
}
